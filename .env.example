# Copy to .env and fill in. .env is gitignored; this template is not.

# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Local Postgres (docker-compose.yml). Compose and Spring both read these.
POSTGRES_DB=enrola
POSTGRES_USER=enrola
POSTGRES_PASSWORD=change-me
# Host port only; the container always listens on 5432 internally.
POSTGRES_PORT=5433

# Password for the /admin review UI. The app will not start without it.
ADMIN_PASSWORD=change-me

# Port the chat server listens on (./serve.sh). Change this and chat.sh needs to be
# pointed at it too: ENROLA_URL=http://localhost:8181 ./chat.sh
# ENROLA_PORT=8080
